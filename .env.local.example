# Email Service Configuration
# Uncomment and configure based on your chosen service

# Option 1: Formspree
# NEXT_PUBLIC_FORMSPREE_ENDPOINT=your_form_endpoint_here

# Option 2: Resend API
# RESEND_API_KEY=your_resend_api_key_here

# Option 3: Custom Email Service
# EMAIL_SERVICE_URL=your_email_service_url

# Google Analytics (Optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sanity CMS (Optional - for blog)
# NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
# NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_TOKEN=your_api_token

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Your Portfolio
